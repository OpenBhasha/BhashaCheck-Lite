# BhashaCheck v2 ML service - copy to v2/server/.env and edit.
# Everything here has a sane default; nothing is required to run Whisper + VAD.

# --- Runtime ---
ML_WORK_DIR=/tmp/bhashacheck-v2
ML_DEVICE=cpu                 # cpu | cuda
SERVE_WEB=true                # serve ../web at / from this app

# --- Models (local, work out of the box) ---
DEMUCS_MODEL=htdemucs
WHISPER_MODEL=small          # tiny | base | small | medium | large

# --- Diarization (optional) ---
# Needs a Hugging Face token AND accepted model terms for the pipeline and its
# dependencies (pyannote/speaker-diarization-community-1, pyannote/segmentation-3.0).
PYANNOTE_PIPELINE=pyannote/speaker-diarization-community-1
HUGGINGFACE_TOKEN=

# --- Extra ASR providers (all optional; blank = shown in the UI but inert) ---
# Wav2Vec2 - HF model id or local path; also `pip install transformers`.
WAV2VEC2_MODEL=
# Conformer / IndicConformer - .nemo checkpoint or pretrained name; needs requirements-nemo.txt.
CONFORMER_MODEL_PATH=
INDIC_CONFORMER_MODEL_PATH=
# Sarvam AI (cloud). Key can also be pasted into the Transcription card in the UI.
SARVAM_API_KEY=
SARVAM_MODEL=saarika:v2
# Gnani.ai (cloud). Set the URL to match your account's contract.
GNANI_API_KEY=
GNANI_API_URL=https://asr.gnani.ai/api/v1/transcribe
